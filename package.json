{
  "name": "baig-home-weather",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "PUBLIC_MOCK=1 PUBLIC_MANIFEST_URL=/manifest.dev.json pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "check": "tsc -p tsconfig.json && pnpm -r check",
    "test": "pnpm -r --if-present test",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
